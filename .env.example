# Pastas (padrões: ./auth e ./media)
# AUTH_DIR=./auth
# MEDIA_DIR=./media

# Nível de log: info | debug | warn | error
# LOG_LEVEL=info
# BAILEYS_LOG_LEVEL=warn

# --- Transcrição de áudio (opcional) ---
# Vazio = desativado (os áudios são salvos, mas sem .txt)
# openai = usa a API /audio/transcriptions
# local  = usa o CLI `whisper` (pip install openai-whisper) instalado na máquina
WHISPER_MODE=

# Idioma (opcional, melhora precisão), ex.: pt
WHISPER_LANGUAGE=pt

# Modelo: openai -> whisper-1 (padrão), gpt-4o-transcribe, gpt-4o-mini-transcribe...
#         local  -> tiny | base (padrão) | small | medium | large | turbo
# WHISPER_MODEL=

# Para WHISPER_MODE=openai
OPENAI_API_KEY=
# Qualquer API compatível com OpenAI (ex.: Groq, servidor whisper local com API)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Para WHISPER_MODE=local: executável compatível com o CLI do openai-whisper
# WHISPER_BIN=whisper
